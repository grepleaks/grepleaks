# Export variables in your shell. The launcher does not source .env files.
BYOK_API_KEY=
BYOK_BASE_URL=
BYOK_MODEL=
# Optional API server authentication.
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=grepleaks
# Optional Docker settings.
GREPLEAKS_IMAGE=grepleaks:local
GREPLEAKS_PORT=4096
# With --host-access only. Defaults to your home; broader roots require Docker sharing.
GREPLEAKS_HOST_ROOT=
