{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "cyan": "#22d3ee",
    "cyanText": "#7dd3fc",
    "cyanBright": "#67e8f9",
    "cyanDim": "#4d7f8a",
    "green": "#00ff9c",
    "greenBright": "#39ff14",
    "purple": "#a970ff",
    "magenta": "#ff2e97",
    "red": "#ff2e63",
    "amber": "#ffb000",
    "yellow": "#ffd23f",
    "white": "#e8f4f8",
    "bg": "#060a0c",
    "bg2": "#0a1114",
    "bg3": "#0f1c20",
    "border": "#16282e",
    "borderSub": "#101d21",
    "addBg": "#0a1f14",
    "remBg": "#1f0a12",
    "lbg": "#f4fafb",
    "lbg2": "#e9f3f5",
    "lbg3": "#dfecef",
    "ltext": "#0a2026",
    "lmuted": "#557079",
    "lcyan": "#0e7490",
    "lgreen": "#008f5a",
    "lpurple": "#7c3aed",
    "lmagenta": "#be1467",
    "lred": "#c81e4a",
    "lamber": "#b5730a",
    "lyellow": "#a8790a",
    "lborder": "#c6dbe0"
  },
  "theme": {
    "primary": { "dark": "cyan", "light": "lcyan" },
    "secondary": { "dark": "green", "light": "lgreen" },
    "accent": { "dark": "purple", "light": "lpurple" },
    "error": { "dark": "red", "light": "lred" },
    "warning": { "dark": "amber", "light": "lamber" },
    "success": { "dark": "greenBright", "light": "lgreen" },
    "info": { "dark": "cyan", "light": "lcyan" },
    "text": { "dark": "cyanText", "light": "ltext" },
    "textMuted": { "dark": "cyanDim", "light": "lmuted" },
    "selectedListItemText": { "dark": "bg", "light": "lbg" },
    "background": { "dark": "bg", "light": "lbg" },
    "backgroundPanel": { "dark": "bg2", "light": "lbg2" },
    "backgroundElement": { "dark": "bg3", "light": "lbg3" },
    "backgroundMenu": { "dark": "bg2", "light": "lbg2" },
    "border": { "dark": "border", "light": "lborder" },
    "borderActive": { "dark": "cyan", "light": "lcyan" },
    "borderSubtle": { "dark": "borderSub", "light": "lborder" },
    "diffAdded": { "dark": "green", "light": "lgreen" },
    "diffRemoved": { "dark": "red", "light": "lred" },
    "diffContext": { "dark": "cyanDim", "light": "lmuted" },
    "diffHunkHeader": { "dark": "cyanBright", "light": "lcyan" },
    "diffHighlightAdded": { "dark": "greenBright", "light": "lgreen" },
    "diffHighlightRemoved": { "dark": "magenta", "light": "lmagenta" },
    "diffAddedBg": { "dark": "addBg", "light": "lbg2" },
    "diffRemovedBg": { "dark": "remBg", "light": "lbg2" },
    "diffContextBg": { "dark": "bg2", "light": "lbg2" },
    "diffLineNumber": { "dark": "cyanDim", "light": "lmuted" },
    "diffAddedLineNumberBg": { "dark": "addBg", "light": "lbg2" },
    "diffRemovedLineNumberBg": { "dark": "remBg", "light": "lbg2" },
    "markdownText": { "dark": "cyanText", "light": "ltext" },
    "markdownHeading": { "dark": "cyanBright", "light": "lcyan" },
    "markdownLink": { "dark": "green", "light": "lgreen" },
    "markdownLinkText": { "dark": "cyan", "light": "lcyan" },
    "markdownCode": { "dark": "yellow", "light": "lyellow" },
    "markdownBlockQuote": { "dark": "cyanDim", "light": "lmuted" },
    "markdownEmph": { "dark": "purple", "light": "lpurple" },
    "markdownStrong": { "dark": "cyanBright", "light": "lcyan" },
    "markdownHorizontalRule": { "dark": "border", "light": "lborder" },
    "markdownListItem": { "dark": "cyanText", "light": "ltext" },
    "markdownListEnumeration": { "dark": "cyan", "light": "lcyan" },
    "markdownImage": { "dark": "green", "light": "lgreen" },
    "markdownImageText": { "dark": "cyan", "light": "lcyan" },
    "markdownCodeBlock": { "dark": "bg2", "light": "lbg2" },
    "syntaxComment": { "dark": "cyanDim", "light": "lmuted" },
    "syntaxKeyword": { "dark": "magenta", "light": "lmagenta" },
    "syntaxFunction": { "dark": "cyan", "light": "lcyan" },
    "syntaxVariable": { "dark": "cyanText", "light": "ltext" },
    "syntaxString": { "dark": "green", "light": "lgreen" },
    "syntaxNumber": { "dark": "yellow", "light": "lyellow" },
    "syntaxType": { "dark": "purple", "light": "lpurple" },
    "syntaxOperator": { "dark": "cyanBright", "light": "lcyan" },
    "syntaxPunctuation": { "dark": "cyanDim", "light": "lmuted" },
    "thinkingOpacity": 0.5
  }
}
